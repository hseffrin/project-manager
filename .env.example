# Postgres connection string, e.g. postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_URL=

# Vercel Blob token (Vercel > Storage > Blob). Leave empty to save uploads to .uploads/ locally.
BLOB_READ_WRITE_TOKEN=

# Set to "local" to force local uploads even when BLOB_READ_WRITE_TOKEN is set.
UPLOAD_DRIVER=
